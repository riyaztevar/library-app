#alb sec group
resource "aws_security_group" "alb-sg" {
  name        = "alb-sg"
  description = "Controls public access to the ALB"
  vpc_id      = aws_vpc.my_vpc.id

  tags = {
    Name = "alb-sg"
  }
}
    # Allow inbound HTTPS from anywhere
 resource "aws_vpc_security_group_ingress_rule" "alb_http" {
  security_group_id = aws_security_group.alb-sg.id
  description       = "HTTP traffic from internet"
  cidr_ipv4         = "0.0.0.0/0"
  from_port         = 80
  to_port           = 80
  ip_protocol       = "tcp"
}

resource "aws_vpc_security_group_ingress_rule" "alb_https" {
  security_group_id = aws_security_group.alb-sg.id
  description       = "HTTP traffic from internet"
  cidr_ipv4         = "0.0.0.0/0"
  from_port         = 443
  to_port           = 443
  ip_protocol       = "tcp"
}

resource "aws_vpc_security_group_egress_rule" "alb_to_app8080" {
  security_group_id            = aws_security_group.alb-sg.id
  description                  = "Allow outbound to app on 8080"
  referenced_security_group_id = aws_security_group.private_sg.id# Restricts destination target
  from_port                    = 8080
  to_port                      = 8080
  ip_protocol                  = "tcp"
}

resource "aws_vpc_security_group_egress_rule" "alb_to_app80" {
  security_group_id            = aws_security_group.alb-sg.id
  description                  = "Allow outbound to app on 80"
  referenced_security_group_id = aws_security_group.private_sg.id
  from_port                    = 80
  to_port                      = 80
  ip_protocol                  = "tcp"
}


resource "aws_lb" "alb" {
  name               = "my-app-alb"
  internal           = false # Set to false so it faces the public internet
  load_balancer_type = "application"
  security_groups    = [aws_security_group.alb-sg.id]
  
  # ALBs must be placed in public subnets to receive public traffic,
  # but they route traffic downstream into target groups located anywhere.
  subnets            = aws_subnet.public[*].id

  enable_deletion_protection = false

  tags = {
    Name = "main-alb"
  }
}


resource "aws_lb_target_group" "app_target_group" {
  name        = "app-target-group"
  port        = 8080 # The port your backend application listens on in private subnets
  protocol    = "HTTP"
  vpc_id      = aws_vpc.my_vpc.id
  target_type = "instance" # Can be "ip" if targeting ECS Fargate or specific private IPs
health_check {
    enabled = true
    port = 8080
    path = "/health"
    protocol = "HTTP"
    interval = 30
    timeout             = 5
    healthy_threshold   = 3
    unhealthy_threshold = 3
    }
}

resource "aws_lb_listener" "http" {
  load_balancer_arn = aws_lb.alb.arn
  port              = "80"
  protocol          = "HTTP"

  default_action {
    type  = "forward"
    forward {
      target_group {
        arn    = aws_lb_target_group.app_target_group.arn
        weight = 100
        }
      }
    }
}